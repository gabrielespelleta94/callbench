# Copia este fichero como .env y pon tus claves (el .env no se sube a git)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# URL de la API de la clínica (huecos y citas) que usan las herramientas del agente
CLINICA_API_URL=http://127.0.0.1:8000
# Speech providers (agent/proveedores.py): for now only "deepgram"
CALLBENCH_STT=deepgram
CALLBENCH_TTS=deepgram
# Where each call writes its metrics JSONL (default: metrics/ at the repo root)
# CALLBENCH_METRICS_DIR=
